meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{api_url}}/v1/contests/{{contest_id}}/submissions
  body: json
  auth: inherit
}

headers {
  "{{csrf_token_header}}": {{csrf_token}}
}

body:json {
  {
    "problemId": "{{problem_id}}",
    "language": "{{language}}",
    "code": {
      "id": "{{code_attachment_id}}"
    }
  }
}

vars:pre-request {
  language: NODE_22
  filepath: 
}

vars:post-response {
  submission_id: res.body.id
}

script:pre-request {
  async function upload(context, contentType) {
    const filepath = bru.getRequestVar("filepath")
    const pathparts = filepath.split(/[\\\/]/)
    const filename = pathparts[pathparts.length - 1]
    bru.setVar("attachment_filepath", filepath)
    bru.setVar("attachment_filename", filename)
    bru.setVar("attachment_context", context)
    bru.setVar("attachment_content_type", contentType)
    
    const signResult = await bru.runRequest("attachment/get_signed_upload_url")
    
    const attachment = signResult.data.attachment
    bru.setVar("file_path", filepath)
    bru.setVar("file_content_type", contentType)
    
    await bru.runRequest("attachment/upload/submission_code")
    
    return attachment.id
  }
  
  const codeAttachmentId = await upload("SUBMISSION_CODE", "text/plain")
  
  bru.setVar("code_attachment_id", codeAttachmentId)
  
}

settings {
  encodeUrl: true
  timeout: 0
}
