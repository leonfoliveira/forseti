meta {
  name: answer
  type: http
  seq: 2
}

post {
  url: {{api_url}}/v1/contests/{{contest_id}}/clarifications/{{clarification_id}}/answer
  body: json
  auth: inherit
}

headers {
  "{{csrf_token_header}}": {{csrf_token}}
}

body:json {
  {
    "text": "New answer"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
