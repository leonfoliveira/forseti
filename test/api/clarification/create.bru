meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{api_url}}/v1/contests/{{contest_id}}/clarifications
  body: json
  auth: inherit
}

headers {
  "{{csrf_token_header}}": {{csrf_token}}
}

body:json {
  {
    "problemId": null,
    "text": "New clarification"
  }
}

vars:post-response {
  clarification_id: res.body.id
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
