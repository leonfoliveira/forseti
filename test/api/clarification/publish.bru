meta {
  name: publish
  type: http
  seq: 3
}

post {
  url: {{api_url}}/v1/contests/{{contest_id}}/clarifications/{{clarification_id}}/publish
  body: none
  auth: inherit
}

headers {
  "{{csrf_token_header}}": {{csrf_token}}
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
