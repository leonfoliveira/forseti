meta {
  name: submission_code
  type: http
  seq: 3
}

put {
  url: {{attachment_upload_url}}
  body: file
  auth: inherit
}

body:file {
  file: @file(\\wsl.localhost\Ubuntu\home\leonfoliveira\forseti\test\files\accepted.js) @contentType(text/javascript; charset=utf-8)
}

script:pre-request {
  const fs = require("fs")
  const path = require("path")
  
  const filepath = bru.getVar("attachment_filepath")
  const fileBuffer = fs.readFileSync(filepath)
  
  req.setBody(fileBuffer)
  
  req.setHeader("Content-Type", "text/plain")
  req.setHeader("Content-Length", fileBuffer.length)
  
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
