meta {
  name: get_signed_upload_url
  type: http
  seq: 1
}

post {
  url: {{api_url}}/v1/contests/{{contest_id}}/attachments
  body: json
  auth: inherit
}

body:json {
  {
    "filename": "code.py",
    "context": "SUBMISSION_CODE",
    "contentType": "text/x-python"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
