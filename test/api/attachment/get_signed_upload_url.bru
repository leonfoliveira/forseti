meta {
  name: get_signed_upload_url
  type: http
  seq: 1
}

post {
  url: {{api_url}}/v1/contests/{{contest_id}}/attachments
  body: json
  auth: inherit
}

headers {
  "{{csrf_token_header}}": {{csrf_token}}
}

body:json {
  {
    "filename": "{{attachment_filename}}",
    "context": "{{attachment_context}}",
    "contentType": "{{attachment_content_type}}"
  }
}

vars:pre-request {
  attachment_filename: problem_description.pdf
  attachment_context: PROBLEM_DESCRIPTION
  attachment_content_type: application/pdf
}

vars:post-response {
  attachment_id: res.body.attachment_id
  attachment_upload_url: decodeURIComponent(res.body.uploadUrl)
}

settings {
  encodeUrl: true
  timeout: 0
}
