meta {
  name: create
  type: http
  seq: 3
}

post {
  url: {{api_url}}/v1/contests
  body: json
  auth: inherit
}

headers {
  "{{csrf_token_header}}": {{csrf_token}}
}

body:json {
    {
      "slug": "{{$randomWord}}",
      "title": "{{$randomWords}}",
      "languages": [
        "CPP_17",
        "JAVA_21",
        "PYTHON_312",
        "NODE_22"
      ],
      "startAt": "2099-01-01T00:00:00Z",
      "endAt": "2099-01-02T00:00:00Z"
    }
}

vars:post-response {
  contest_slug: res.body.slug
  contest_id: res.body.id
}

settings {
  encodeUrl: true
  timeout: 0
}
