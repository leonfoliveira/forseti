meta {
  name: update
  type: http
  seq: 4
}

put {
  url: {{api_url}}/v1/contests/{{contest_id}}
  body: json
  auth: inherit
}

headers {
  "{{csrf_token_header}}": {{csrf_token}}
}

body:json {
  {
      "id": "{{contest_id}}",
      "slug": "{{$randomWord}}",
      "title": "{{$randomWords}}",
      "languages": [
        "CPP_17",
        "JAVA_21",
        "PYTHON_312",
        "NODE_22"
      ],
      "startAt": "2099-01-01T00:00:00Z",
      "endAt": "2099-01-02T00:00:00Z",
      "members": [
        {
          "type": "ADMIN",
          "name": "{{$randomFirstName}}",
          "login": "admin",
          "password": "123"
        },
        {
          "type": "JUDGE",
          "name": "{{$randomFirstName}}",
          "login": "judge",
          "password": "123"
        },
        {
          "type": "CONTESTANT",
          "name": "{{$randomFirstName}}",
          "login": "contestant",
          "password": "123"
        }
      ],
      "problems": [
        {
          "letter": "A",
          "color": "#ffffff",
          "title": "{{$randomWords}}",
          "description": {
            "id": "{{description_attachment_id}}"
          },
          "timeLimit": 1000,
          "memoryLimit": 1024,
          "testCases": {
            "id": "{{test_cases_attachment_id}}"
          }
        }
      ]
    }
}

vars:post-response {
  problem_id: res.body.problems[0].id
}

script:pre-request {
  async function upload(filename, context, contentType) {
    bru.setVar("attachment_filename", filename)
    bru.setVar("attachment_context", context)
    bru.setVar("attachment_content_type", contentType)
    
    const signResult = await bru.runRequest("attachment/get_signed_upload_url")
    
    const attachment = signResult.data.attachment
    bru.setVar("file_path", `../files/${filename}`)
    bru.setVar("file_content_type", contentType)
    
    await bru.runRequest(`attachment/upload/${filename.split('.')[0]}`)
    
    return attachment.id
  }
  
  const descriptionAttachmentId = await upload("problem_description.pdf", "PROBLEM_DESCRIPTION", "application/pdf")
  const testCasesAttachmentId = await upload("problem_test_cases.csv", "PROBLEM_TEST_CASES", "text/csv")
  
  bru.setVar("description_attachment_id", descriptionAttachmentId)
  bru.setVar("test_cases_attachment_id", testCasesAttachmentId)
  
}

settings {
  encodeUrl: true
  timeout: 0
}
