meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{api_url}}/v1/contests/{{contest_id}}/announcements
  body: json
  auth: inherit
}

headers {
  "{{csrf_token_header}}": {{csrf_token}}
}

body:json {
  {
    "text": "Announcement text"
  }
}

vars:pre-request {
  contest_id: 01a13ac6-c271-7d3e-aa0a-e9c40da225b3
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
