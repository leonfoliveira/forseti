meta {
  name: update_status
  type: http
  seq: 2
}

patch {
  url: {{api_url}}/v1/contests/{{contest_id}}/print-requests/{{print_request_id}}/status
  body: json
  auth: inherit
}

headers {
  "{{csrf_token_header}}": {{csrf_token}}
}

body:json {
    {
      "status": "COMPLETED"
    }
}

settings {
  encodeUrl: true
  timeout: 0
}
