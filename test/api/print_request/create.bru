meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{api_url}}/v1/contests/{{contest_id}}/print-requests
  body: json
  auth: inherit
}

headers {
  "{{csrf_token_header}}": {{csrf_token}}
}

body:json {
    {
      "submissionId": "{{submission_id}}"
    }
}

vars:post-response {
  print_request_id: res.body.id
}

settings {
  encodeUrl: true
  timeout: 0
}
