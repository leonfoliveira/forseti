meta {
  name: authenticate_contest
  type: http
  seq: 2
}

post {
  url: {{api_url}}/v1/contests/{{contest_id}}:sign-in
  body: json
  auth: inherit
}

body:json {
  {
    "login": "{{member_login}}",
    "password": "123"
  }
}

vars:pre-request {
  contest_id: 
  member_login: contestant
}

vars:post-response {
  csrf_token: res.headers["set-cookie"][1].match(/csrf_token=(.+?)(;|$)/)[1]
}

settings {
  encodeUrl: true
  timeout: 0
}
