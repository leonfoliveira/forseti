# Settings of the staging environment, read by deploy.sh. Nothing here is secret.

# Region of the environment (ECR, CloudFormation, ECS, RDS...)
REGION=us-east-2

# Root domain. Staging serves the webapp from staging.DOMAIN and the API from api.staging.DOMAIN.
DOMAIN=forsetijudge.com

# Optional: email address subscribed to the alarm topic (needs a confirmation click the first time)
ALARM_EMAIL=

# Optional overrides. When empty, deploy.sh looks them up: the hosted zone by DOMAIN, and the certificate in the
# forseti-certificate stack of us-east-1.
HOSTED_ZONE_ID=
CLOUDFRONT_CERTIFICATE_ARN=
