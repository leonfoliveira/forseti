# Settings of the account-wide stacks (ECR repositories and CloudFront certificate), read by deploy.sh.
# Nothing here is secret.

# Region of the container registry
REGION=us-east-2

# CloudFront only accepts certificates from this region
CERTIFICATE_REGION=us-east-1

# Root domain covered by the certificate (also *.DOMAIN and *.staging.DOMAIN)
DOMAIN=forsetijudge.com

# Optional override. When empty, deploy.sh looks the hosted zone up by DOMAIN.
HOSTED_ZONE_ID=
